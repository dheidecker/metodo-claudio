{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Proyectos/metodo-claudio/hooks/compactacion.sh",
            "timeout": 20,
            "statusMessage": "Guardando punto de compactación…"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Proyectos/metodo-claudio/hooks/compactacion.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "~/Proyectos/metodo-claudio/hooks/precommit-credenciales.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/Proyectos/metodo-claudio/hooks/statusline.sh",
    "refreshInterval": 5
  }
}
