#!/usr/bin/env python3
"""Hook Stop: ¿los archivos cambiados que el mapa asigna a una función tienen evidencia vigente?

Solo LEE `.claude/evidencia/`; nunca verifica (CONTRATO §5). Vigente = huella sha256 igual al
archivo actual y la función que lo cubre con ok: true.
- stop_hook_active            -> exit 0.
- sin .claude/mecanismo.yml   -> exit 0, en silencio.
- sin PyYAML                  -> exit 0 y `sin-pyyaml` en la bitácora.
- falta evidencia: puerta aviso -> exit 0 con systemMessage; puerta bloqueo -> exit 2 con el comando.
- archivos fuera del mapa: no exigen evidencia, se anotan en la bitácora.
"""
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent))
from lib import comun  # noqa: E402

HOOK = "stop-evidencia"


def main() -> int:
    d = comun.leer_stdin_json()
    if d.get("stop_hook_active"):
        return 0
    raiz = comun.raiz_proyecto(d.get("cwd") or None)
    proy = raiz.name
    if not (raiz / ".claude" / "mecanismo.yml").is_file():
        return 0
    from lib.evidencia import nucleo  # noqa: PLC0415
    try:
        conf = nucleo.leer_conf(raiz) or {}
        mapa = nucleo.leer_mapa(raiz)
    except comun.SinPyYAML:
        comun.bitacora(HOOK, "sin-pyyaml", proyecto=proy)
        return 0
    except Exception as e:  # noqa: BLE001 — un yml roto no puede romper la sesión
        comun.bitacora(HOOK, f"error {type(e).__name__}", proyecto=proy)
        return 0

    cambiados = comun.archivos_cambiados(raiz, comun.desde_sesion(d.get("session_id")))
    falta, sin_mapa = nucleo.faltantes(raiz, cambiados, mapa)
    if sin_mapa:
        muestra = ",".join(pathlib.Path(x).name for x in sin_mapa[:5]) + ("…" if len(sin_mapa) > 5 else "")
        comun.bitacora(HOOK, f"silencio sin-mapa {len(sin_mapa)} {muestra}", proyecto=proy)
    if not falta:
        if cambiados and len(sin_mapa) < len(cambiados):
            comun.bitacora(HOOK, "ok evidencia vigente", proyecto=proy)
        return 0

    fids = [f["id"] for f in mapa if f["id"] in falta]
    cmd = nucleo.comando_verificar(fids)
    archivos = sorted({a for v in falta.values() for a in v})
    lista = ", ".join(archivos[:6]) + (f" y {len(archivos) - 6} más" if len(archivos) > 6 else "")
    bloqueo = conf.get("puerta") == "bloqueo"
    if bloqueo:
        msg = (f"No se da por terminado: falta evidencia vigente de {', '.join(fids)} "
               f"(cambiaron {lista}). Corre: {cmd}")
        comun.bitacora(HOOK, f"BLOQUEO {','.join(fids)}", proyecto=proy)
        return comun.salida_hook("Stop", msg, bloquear=True)
    msg = (f"Falta evidencia vigente de {', '.join(fids)} (cambiaron {lista}). "
           f"Antes de darlo por terminado corre: {cmd}")
    comun.bitacora(HOOK, f"AVISO {','.join(fids)}", proyecto=proy)
    # Stop no admite hookSpecificOutput: solo systemMessage, igual que stop-lint.sh.
    print(json.dumps({"systemMessage": msg}, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
